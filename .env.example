# iTala Connect environment. Copy to .env.local and fill in real values.
# Never commit real values. Only NEXT_PUBLIC_* reach the browser, and only
# publishable values may use that prefix (CLAUDE.md, plan section 5).

# --- Public (browser) ---------------------------------------------------
# iTala Connect Supabase project URL. Local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Public by design; RLS is the boundary.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical site URL for auth redirects and share previews. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# --- Server only ----------------------------------------------------------
# Secret key (sb_secret_...). Only for admin account management, storage
# cleanup, durable mobile link delivery and scripts. Never used for ordinary reads or writes.
SUPABASE_SECRET_KEY=
# Storage bucket for images. Default: images
SUPABASE_STORAGE_BUCKET=
# Default time zone for new events. Default: Pacific/Auckland
DEFAULT_EVENT_TIMEZONE=
# Design prototypes with sample data at /prototype/*. 1 = on. Never set in production.
ENABLE_PROTOTYPES=

# iTala mobile scorekeeper project. League/result database reads remain read only.
# Optional link delivery uses the dedicated mobile Edge endpoint. Leave blank
# to turn the integration off.
MOBILE_SUPABASE_URL=
MOBILE_SUPABASE_PUBLISHABLE_KEY=
MOBILE_REPORTS_READ_SECRET=

# Server-only link delivery authentication. Set the same random value (at least
# 32 characters) on the mobile connect-link-state Edge Function. No mobile
# service-role key is needed here. Leave blank until both migrations are applied.
CONNECT_LINK_SYNC_SECRET=

# --- Migration script only (phase 7, removed after cutover) --------------
FIREBASE_DATABASE_URL=
FIREBASE_SERVICE_ACCOUNT_JSON=
